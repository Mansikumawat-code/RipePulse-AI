# RipePulse AI — Frontend Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# Backend FastAPI base URL (must include /api suffix)
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: override WebSocket URL
# Defaults to ws://localhost:8000/ws when unset.
# VITE_WS_URL=ws://localhost:8000/ws

# Render production values:
# VITE_API_BASE_URL=https://ripepulse-ai.onrender.com/api
# VITE_WS_URL=wss://ripepulse-ai.onrender.com/ws
